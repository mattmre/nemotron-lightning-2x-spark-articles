# Copy separately on each node as dual-spark/.env; never commit the filled file.
# Absolute local directory containing the Hugging Face hub cache (blobs/snapshots).
HF_HUB_CACHE=/path/to/huggingface/hub
# Head: 127.0.0.1, 8801, 10. Worker: private interconnect IP, 8890, 12.
BIND_IP=127.0.0.1
BACKEND_PORT=8801
MAX_NUM_SEQS=10
# Configure on the head only: private hostname/IP reachable from the head.
WORKER_HOST=spark-worker.example.invalid
